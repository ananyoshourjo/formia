{
  "appId": "com.formia.app",
  "productName": "Formia",
  "asar": true,
  "electronVersion": "44.0.0",
  "electronDist": "../node_modules/electron/dist",
  "npmRebuild": false,
  "directories": {
    "output": "../release"
  },
  "files": [
    "electron/**/*",
    "out/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "signAndEditExecutable": false,
    "artifactName": "Formia-${version}-Setup.${ext}"
  }
}
